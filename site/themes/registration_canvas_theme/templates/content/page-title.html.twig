{#
/**
 * @file
 * Page title: an h1 with the heading component's look, including the
 * highlighted start of the text (the heading_lead filter).
 *
 * Available variables:
 * - title: the page title, as Drupal provides it.
 * - title_text: the title as plain text, set in
 *   registration_canvas_theme_preprocess_page_title(); empty when the title is
 *   not shown because the page's Canvas template already prints a heading.
 */
#}
{{ title_prefix }}
{% if title and title_text %}
  <h1{{ title_attributes.addClass('page-title', 'c-heading', 'c-heading--size-default', 'c-heading--color-default', 'c-heading--align-left') }}>{{ title_text|heading_lead }}</h1>
{% endif %}
{{ title_suffix }}
