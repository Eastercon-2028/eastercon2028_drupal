{#
/**
 * @file
 * Button component. Props mirror Mercury's button.
 *
 * Icons are inline SVG paths from the Phosphor icon set (MIT,
 * https://phosphoricons.com), so the component does not depend on an icon
 * pack from another theme.
 */
#}
