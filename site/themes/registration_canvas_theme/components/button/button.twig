} %}
{% set is_disabled = disabled|default(false) %}
{% set classes = [
  'c-button',
  'c-button--' ~ variant|default('primary'),
  'c-button--' ~ size|default('medium'),
  mobile_width|default(false) ? 'c-button--mobile-full',
  icon is not empty and icon_first|default(false) ? 'c-button--icon-first',
] %}
{% set icon_markup %}
  {% if icon is not empty and icon_paths[icon] is defined %}
    <span class="c-button__icon"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256" fill="currentColor" aria-hidden="true" focusable="false"><path d="{{ icon_paths[icon] }}"/></svg></span>
  {% endif %}
{% endset %}

{% if href and not is_disabled %}
  <a{{ attributes.addClass(classes).setAttribute('href', href) }}>{{ icon_markup }}{{ label }}</a>
{% else %}
  <button{{ attributes.addClass(classes).setAttribute('type', 'button') }}{{ is_disabled ? ' disabled' }}>{{ icon_markup }}{{ label }}</button>
{% endif %}
